# ============================================================================
# .env.example — copy to .env.local and fill in values
# NEVER commit .env.local or any file with real secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
# NEXT_PUBLIC_* are exposed to the browser — that's fine for the URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key — SERVER ONLY. Never expose to the browser.
# Used in Edge Functions and server-only code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Supabase project ref (used by CLI + CI)
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
# Public URL of the deployed app (used for email links, CORS, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default locale fallback
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ----------------------------------------------------------------------------
# Rate limiting (Upstash Redis)
# Get these from: https://console.upstash.com → your Redis database → REST API
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------------------
# Email (for reports, invites, password resets)
# Phase 0: placeholder. Phase 1 will wire the real provider.
# Options: Resend, Supabase Auth email, Postmark
# ----------------------------------------------------------------------------
EMAIL_FROM=no-reply@example.com
# RESEND_API_KEY=

# ----------------------------------------------------------------------------
# Web push notifications (added in Phase 7)
# Generate: npx web-push generate-vapid-keys
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# ----------------------------------------------------------------------------
# Observability (later phase)
# ----------------------------------------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ----------------------------------------------------------------------------
# Dev flags
# ----------------------------------------------------------------------------
# Set to 'true' to enable extra logging in dev. Never set in production.
# DEBUG_VERBOSE=false

# ============================================================================
# .env.example — copy to .env.local and fill in values
# NEVER commit .env.local or any file with real secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
# NEXT_PUBLIC_* are exposed to the browser — that's fine for the URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key — SERVER ONLY. Never expose to the browser.
# Used in Edge Functions and server-only code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Supabase project ref (used by CLI + CI)
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
# Public URL of the deployed app (used for email links, CORS, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default locale fallback
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ----------------------------------------------------------------------------
# Rate limiting (Phase 9 — DB-backed, D-035)
# No external Redis required; fixed-window counters live in a public.rate_limits
# table and are checked via a SECURITY DEFINER RPC. Nothing to set here.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Cron / Edge Function shared secret
# Used by detect-attendance-issues / detect-live-issues / stock-reconcile /
# cron-scheduled-reports / generate-report to authenticate cron calls.
# Rotate quarterly. Set via `supabase secrets set CRON_SECRET=<value>`.
# ----------------------------------------------------------------------------
CRON_SECRET=change-me-before-deploy

# ----------------------------------------------------------------------------
# Email delivery (Phase 9 — D-034, Resend)
# Optional: if unset, export-ready emails are skipped and only the in-app
# notification fires. Swap providers by replacing lib/email/send.ts.
# ----------------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=no-reply@example.com

# ----------------------------------------------------------------------------
# Web push notifications (Phase 9.1 follow-up — deferred per D-036)
# Not yet wired; listed here so the ops team knows which vars to generate
# when Phase 9.1 ships. `npx web-push generate-vapid-keys`.
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# ----------------------------------------------------------------------------
# Observability (Phase 9 — D-037)
# Structured logs always written to stdout. SENTRY_DSN is a soft-attach: if
# set AND instrumentation.ts mounts @sentry/node (or similar) on globalThis,
# reportError() forwards unhandled errors. If unset, everything still works;
# logs go to Vercel + Supabase dashboards only.
# ----------------------------------------------------------------------------
# LOG_LEVEL=info         # debug | info | warn | error
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ----------------------------------------------------------------------------
# Dev flags
# ----------------------------------------------------------------------------
# Set to 'true' to enable extra logging in dev. Never set in production.
# DEBUG_VERBOSE=false
